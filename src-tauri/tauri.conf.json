{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HandoffGG",
  "version": "0.1.0",
  "identifier": "dev.tteles.handoffgg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "HandoffGG",
        "width": 983,
        "height": 667,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": [27, 29, 32, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
